ARG PYTHON_BUILD_IMAGE=python:3.12.14-trixie@sha256:4d1caded1f729ae443eb803f26ffde7b61e696aeaef62f099abb6dd6b14257c7
FROM ${PYTHON_BUILD_IMAGE}
ARG APP_VERSION=stable
ARG CHAOS_MODE=false
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    APP_VERSION=${APP_VERSION} \
    CHAOS_MODE=${CHAOS_MODE}
WORKDIR /app
COPY . .
RUN python -m pip install --no-cache-dir \
        -r requirements.txt -r requirements-container.txt \
    && python -m build \
    && python -m pip install --no-cache-dir --no-deps dist/*.whl
EXPOSE 5000
CMD ["gunicorn", "--no-control-socket", "--bind=0.0.0.0:5000", "--workers=1", "--worker-class=gthread", "--threads=4", "--timeout=30", "--graceful-timeout=30", "--worker-tmp-dir=/tmp", "--access-logfile=-", "--error-logfile=-", "app:create_app()"]
